{
  "manifest_version": 3,
  "name": "Gabaritei · Importar do NotebookLM",
  "description": "Importa um quiz aberto no NotebookLM para os cadernos do Gabaritei.",
  "version": "0.1.1",
  "key": "",
  "background": {"service_worker": "background.js"},
  "host_permissions": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"],
  "externally_connectable": {"matches": ["https://sg-devstudio.github.io/*", "https://app-gestao-estudos.web.app/*"]},
  "content_scripts": [
    {"matches": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"], "js": ["studio.js"]},
    {"matches": ["https://*.scf.usercontent.goog/*"], "js": ["quiz.js"], "all_frames": true, "match_origin_as_fallback": true}
  ]
}
